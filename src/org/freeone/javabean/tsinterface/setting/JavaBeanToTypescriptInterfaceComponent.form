<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.freeone.javabean.tsinterface.setting.JavaBeanToTypescriptInterfaceComponent">
  <grid id="27dc6" binding="jPanel" layout-manager="GridLayoutManager" row-count="8" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="435"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="4f448" class="javax.swing.JCheckBox" binding="useJsonPropertyCheckBox">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="use @JsonProperty"/>
        </properties>
      </component>
      <component id="42fdf" class="javax.swing.JCheckBox" binding="allowFindClassInAllScope">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="allow find class in all scope"/>
        </properties>
      </component>
      <vspacer id="572e6">
        <constraints>
          <grid row="1" column="0" row-span="2" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="0" indent="1" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <component id="ece66" class="javax.swing.JCheckBox" binding="ignoreParentField">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="ignore parent fields"/>
        </properties>
      </component>
      <scrollpane id="5f68c" binding="jScrollPanel">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="400" height="-1"/>
            <preferred-size width="400" height="-1"/>
            <maximum-size width="400" height="-1"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="3b5c9" class="javax.swing.JTable" binding="enableNameToStringListTable">
            <constraints/>
            <properties>
              <autoCreateRowSorter value="false"/>
              <autoResizeMode value="0"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="bdf88" binding="tableActionsPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="410" height="-1"/>
            <preferred-size width="410" height="-1"/>
            <maximum-size width="410" height="-1"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="887d7" class="javax.swing.JButton" binding="addButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="ADD"/>
            </properties>
          </component>
          <component id="e3eca" class="javax.swing.JButton" binding="deleteButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="DELETE"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="c4d" class="javax.swing.JLabel" binding="labelUnderTable">
        <constraints>
          <grid row="7" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Press Enter after editing table.(编辑行数据后要按回车)"/>
        </properties>
      </component>
      <component id="8d46" class="javax.swing.JCheckBox" binding="dateToStringCheckBox" default-binding="true">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
